# One look in the fleet ledger for orders addressed to this host and for the
# tissue it belongs to; carries out its part of both and exits. Started by
# capsule-orders.timer. Nothing listens and nothing stays running.
[Unit]
Description=Carry out capsule orders waiting for this host
After=network-online.target

[Service]
Type=oneshot
# "-": a host with no orders set up can still follow a tissue, and the other way round.
ExecStart=-/usr/local/bin/capsule orders
ExecStart=/usr/local/bin/capsule tend
# Keep the journal for what capsule says, not a line for every quiet look.
SyslogLevel=notice
LogLevelMax=notice
